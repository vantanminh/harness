{
  "name": "5harness",
  "version": "0.27.0",
  "description": "Agent-ready repository harness — global CLI with markdown durable SoT",
  "type": "module",
  "bin": {
    "harness": "dist/cli.js",
    "5harness": "dist/cli.js",
    "5hn": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "bin",
    "install",
    "templates",
    "migrations",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build-native.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('target',{recursive:true,force:true})})\"",
    "prepack": "npm run build",
    "security:check": "node scripts/security-check.mjs",
    "checksums": "node scripts/checksums.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "install:smoke": "node scripts/npm-install-smoke.mjs",
    "bump": "node scripts/bump-version.mjs",
    "push": "node scripts/safe-push.mjs",
    "release:check": "npm run security:check && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test --all-targets && npm run pack:check",
    "test": "cargo test",
    "test:watch": "cargo test",
    "harness": "cargo run --",
    "typecheck": "cargo check"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "harness",
    "agents",
    "cli",
    "markdown",
    "npm",
    "rust"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantanminh/5harness.git"
  },
  "bugs": {
    "url": "https://github.com/vantanminh/5harness/issues"
  },
  "homepage": "https://github.com/vantanminh/5harness#readme",
  "author": "vantanminh"
}
